# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site URL (used for auth redirects, QR codes, etc.)
VITE_SITE_URL=https://your-hackathon.example.com

# Use a separate Supabase project/database from Factory26.
# The URL and anon key above must belong to the Cosmos26 project.

# CosmosBench powers evaluation and the public leaderboard.
VITE_COSMOSBENCH_URL=https://your-cosmosbench.example.com/competition
VITE_COSMOSBENCH_LEADERBOARD_API=https://your-cosmosbench.example.com/api/competitions/leaderboard

# URL path where the app is mounted. Must start and end with a slash.
VITE_BASE_PATH=/

# If CosmosBench does not allow browser CORS, configure an HTTPS proxy URL above.
